{
  "name": "tula-hospital-map",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "node scripts/build-workers.mjs && vite --host 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "test": "node scripts/build-workers.mjs && node local-routing/build-engine.mjs && node --test tests/*.test.mjs",
    "build": "npm run typecheck && node scripts/build-workers.mjs && node local-routing/build-engine.mjs && vite build && node scripts/manifest.mjs",
    "package": "npm run build && node scripts/package.mjs"
  },
  "dependencies": {
    "@fontsource-variable/geist": "^5.3.0",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.0",
    "lucide-react": "^1.62.0",
    "radix-ui": "^1.8.1",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "sonner": "^2.0.8",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "24.10.0",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "@vitejs/plugin-react": "5.1.0",
    "esbuild": "0.25.12",
    "fake-indexeddb": "^6.2.6",
    "shadcn": "^4.23.0",
    "tailwindcss": "^4.3.3",
    "typescript": "5.9.3",
    "vite": "7.3.7"
  }
}
